---
import { getCollection } from "astro:content"
import ArticleCard from "@/components/blog/ArticleCard.astro"
import Footer from "@/components/site/Footer.astro"
import Navbar from "@/components/site/Navbar.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { estimateReadTime } from "@/utils/reading-time"

const allArticles = await getCollection("blog", ({ data }) => !data.draft)
const sorted = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const articlesByYear = sorted.reduce<Record<number, typeof sorted>>((acc, article) => {
  const year = article.data.date.getFullYear()
  if (!acc[year]) acc[year] = []
  acc[year].push(article)
  return acc
}, {})

const years = Object.keys(articlesByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<BaseLayout
  title="Blog | Bernard Katamanso"
  description="Technical writing on software engineering, systems, and AI."
>
  <div class="min-h-screen bg-background text-foreground font-sans">
    <Navbar />
    <!-- Navbar is fixed (~82px including its top inset), so this page must
         reserve its own top band instead of letting content slide beneath it. -->
    <main id="main-content" class="max-w-3xl mx-auto px-4 sm:px-6 pt-28 sm:pt-32 pb-16">
      <header class="mb-16">
        <div class="flex items-center justify-between gap-4 mb-4">
          <h1 class="text-3xl font-medium tracking-tight">Blog</h1>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors shrink-0"
            aria-label="Subscribe via RSS"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            RSS
          </a>
        </div>
        <p class="text-muted-foreground text-lg max-w-xl">
          Technical deep-dives on software engineering, systems architecture, and AI.
        </p>
      </header>

      <div class="space-y-12">
        {years.map((year) => (
          <section>
            <h2 class="text-sm font-medium text-muted-foreground mb-4 sticky top-[5.25rem] z-10 bg-background py-2">
              {year}
            </h2>
            <div class="space-y-0">
              {articlesByYear[year].map((article, index) => (
                <ArticleCard
                  title={article.data.title}
                  description={article.data.description}
                  date={article.data.date}
                  slug={article.id}
                  readingTime={estimateReadTime(article.body)}
                  image={article.data.image}
                  loading={index === 0 && year === years[0] ? "eager" : "lazy"}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
