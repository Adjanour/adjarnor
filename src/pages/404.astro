---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="404 — Page Not Found | Bernard Katamanso">
  <main class="min-h-screen flex items-center justify-center px-4 sm:px-6 py-12 sm:py-24">
    <div class="text-center max-w-lg">
      <div class="mb-10 relative">
        <span class="text-[8rem] sm:text-[10rem] font-mono font-bold text-foreground/[0.03] leading-none select-none absolute inset-0 flex items-center justify-center">
          404
        </span>
        <div class="relative">
          <div class="inline-block font-mono text-sm text-muted-foreground bg-muted/40 rounded-md px-4 py-3 border border-border/50">
            <span class="text-primary/70">$</span> curl -s /page-you-wanted
            <br />
            <span class="text-destructive/80">error: path not found</span>
            <br />
            <span class="text-muted-foreground/50">exit code: 404</span>
          </div>
        </div>
      </div>

      <h1 class="text-2xl sm:text-3xl font-serif font-normal mb-3 tracking-tight text-foreground">
        Lost in the void
      </h1>
      <p class="text-muted-foreground mb-8 leading-relaxed max-w-md mx-auto">
        This page doesn't exist. Either it was never here, or it moved somewhere you can't reach.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="px-5 py-2.5 bg-foreground text-background rounded-md hover:opacity-90 transition-opacity font-sans text-sm font-medium"
        >
          Back to safety
        </a>
        <a
          href="/blog/"
          class="px-5 py-2.5 border border-border/60 text-foreground rounded-md hover:bg-accent transition-colors font-sans text-sm font-medium"
        >
          Read the blog
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
