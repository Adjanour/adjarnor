---
import Footer from "@/components/site/Footer.astro"
import Navbar from "@/components/site/Navbar.astro"
import WritingCard from "@/components/site/WritingCard.astro"
import { getArticles } from "@/data/articles"
import BaseLayout from "@/layouts/BaseLayout.astro"

const articles = await getArticles()
const articlesByYear = articles.reduce((acc, article) => {
  const year = new Date(article.date).getFullYear()
  if (!acc[year]) acc[year] = []
  acc[year].push(article)
  return acc
}, {})

const years = Object.keys(articlesByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<BaseLayout
  title="Writing | Bernard Katamanso"
  description="Technical writing on software engineering, systems architecture, developer tooling, and infrastructure."
  image="/og-image.png"
>
  <div class="min-h-screen bg-background text-foreground font-sans">
    <Navbar />
    <!-- Fixed navbar owns ~82px at the top; reserve a content band below it. -->
    <main id="main-content" class="max-w-3xl mx-auto px-4 sm:px-6 pt-28 sm:pt-32 pb-16">
      <header class="mb-16">
        <h1 class="text-3xl font-medium tracking-tight mb-4">Writing</h1>
        <p class="text-muted-foreground text-lg max-w-xl">
          Technical writing on software engineering, systems architecture, and
          developer tooling.
        </p>
      </header>

      <div class="space-y-12">
        {years.map((year) => (
          <section>
            <h2 class="text-sm font-medium text-muted-foreground mb-4 sticky top-[5.25rem] z-10 bg-background py-2">
              {year}
            </h2>
            <div class="space-y-0">
              {articlesByYear[year].map((article, index) => (
                <WritingCard
                  title={article.title}
                  date={article.date}
                  excerpt={article.excerpt}
                  href={article.href}
                  readTime={article.readTime}
                  image={article.image}
                  loading={index === 0 && year === years[0] ? "eager" : "lazy"}
                />
              ))}
            </div>
          </section>
        ))}
      </div>

      <section class="mt-20 pt-12 border-t border-border">
        <div class="text-center">
          <h3 class="text-lg font-medium mb-2">Stay updated</h3>
          <p class="text-muted-foreground mb-6">
            Subscribe to get new articles delivered to your inbox.
          </p>
          <a
            href="https://bernardkirkadjanorkatamanso.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-foreground text-background rounded-lg hover:opacity-90 transition-opacity font-medium"
          >
            Subscribe on Substack
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
