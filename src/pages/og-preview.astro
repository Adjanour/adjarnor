---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Navbar from "@/components/site/Navbar.astro"
import Footer from "@/components/site/Footer.astro"

const articles = await getCollection("blog", ({ data }) => !data.draft)
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const cards = [
  {
    label: "Site / Home",
    image: "/og-image.png",
    page: "/",
    description: "Default card for the portfolio and non-article pages.",
  },
  ...articles.map((article) => ({
    label: article.data.title,
    image: `/og/${article.id}.png`,
    page: `/blog/${article.id}/`,
    description: article.data.subtitle ?? article.data.description,
  })),
]
---

<BaseLayout
  title="OG image preview | Bernard Katamanso"
  description="Internal preview gallery for generated social sharing images."
  noindex
>
  <div class="min-h-screen bg-background text-foreground">
    <Navbar />
    <main id="main-content" class="container-page py-12 sm:py-16">
      <header class="max-w-3xl mb-12">
        <p class="text-sm font-medium text-primary mb-3">Internal visual QA</p>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">OG image preview</h1>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          These are the exact 1200×630 files social crawlers receive. Open a
          card at full resolution, or copy its public URL for LinkedIn,
          X/Twitter, Slack, Discord, and debugger tools.
        </p>
        <p class="mt-3 text-sm text-muted-foreground">
          Generated cards: <span class="font-medium text-foreground">{cards.length}</span>
          · Aspect ratio: <span class="font-medium text-foreground">1.91:1</span>
        </p>
      </header>

      <section class="grid gap-8 lg:grid-cols-2" aria-label="Generated OG cards">
        {cards.map((card, index) => (
          <article class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
            <a
              href={card.image}
              target="_blank"
              rel="noreferrer"
              class="block overflow-hidden bg-muted"
              aria-label={`Open ${card.label} OG image at full resolution`}
            >
              <img
                src={card.image}
                alt={`${card.label} social sharing preview`}
                width="1200"
                height="630"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="aspect-[1200/630] w-full object-cover transition-transform duration-300 hover:scale-[1.01]"
              />
            </a>
            <div class="p-4 sm:p-5">
              <h2 class="font-medium leading-snug">{card.label}</h2>
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{card.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <a
                  href={card.image}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted hover:border-foreground/25 transition-colors"
                >
                  Open 1200×630
                </a>
                <button
                  type="button"
                  data-copy-og={card.image}
                  class="inline-flex items-center rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted hover:border-foreground/25 transition-colors"
                >
                  Copy public URL
                </button>
                <a
                  href={card.page}
                  class="ml-auto text-xs text-muted-foreground hover:text-foreground transition-colors"
                >
                  View page →
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-copy-og]")
    if (!button) return

    const path = button.dataset.copyOg
    if (!path) return

    await navigator.clipboard.writeText(new URL(path, window.location.origin).toString())
    const previous = button.textContent
    button.textContent = "Copied"
    window.setTimeout(() => {
      button.textContent = previous
    }, 1400)
  })
</script>
