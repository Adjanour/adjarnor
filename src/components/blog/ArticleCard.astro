---
import { Image } from "astro:assets"
import articleFallback from "@/assets/article-art-fallback.webp"

interface Props {
  title: string
  description: string
  date: Date
  slug: string
  readingTime?: string
  /** Optional per-post art; falls back to the shared sticker tile. */
  image?: string
  loading?: "eager" | "lazy"
}

const { title, description, date, slug, readingTime, image, loading = "lazy" } = Astro.props
const formattedDate = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
})
---

<a
  href={`/blog/${slug}/`}
  class="group block py-5 hover:bg-muted/30 -mx-3 px-3 rounded-sm transition-colors"
>
  <article class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
    <div class="shrink-0 sm:w-24 text-xs text-muted-foreground tabular-nums leading-snug flex items-center gap-2 sm:block">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {readingTime && <span class="text-muted-foreground/60 block mt-0.5">{readingTime}</span>}
    </div>
    <!-- Art tile: sticker fallback for imageless posts; per-post `image:`
         frontmatter overrides. Hidden below sm where the list stays
         typographic. -->
    <div class="shrink-0 w-16 h-16 rounded-md overflow-hidden border border-border hidden sm:block">
      <Image
        src={image ?? articleFallback}
        alt=""
        width="64"
        height="64"
        loading={loading}
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-base font-medium text-foreground group-hover:text-primary transition-colors leading-snug">
        {title}
      </h3>
      <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
        {description}
      </p>
    </div>
    <svg
      class="w-4 h-4 text-muted-foreground shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  </article>
</a>
