---
import DynamicElements from "./DynamicElements.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="fixed top-0 left-0 w-full right-0 z-50 px-4 sm:px-6 pt-4">
  <nav
    id="site-nav"
    class="site-nav rounded-1xl sm:rounded-[18px] py-3"
  >
    <div class="flex items-center justify-between gap-2 sm:gap-4 w-full">
      <a
        href="/#home"
        class="min-w-0 whitespace-nowrap font-signature text-[1.7rem] font-medium leading-none tracking-normal hover:text-primary transition-colors"
      >
        Adjarnor
      </a>
      <DynamicElements />
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a
          href="/resume"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
          >Resume</a
        >
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<style>
  /*
    * Seated state: geometrically identical to `container-page`.
    * Same 4xl max-width (which, under box-sizing: border-box, INCLUDES
   * padding) and the same gutters — so the nav's text column matches
   * the page's text column exactly. The pill furniture (bg, border,
   * shadow) is transparent/invisible.
   */
  .site-nav {
    margin-inline: auto;
    max-width: var(--container-4xl);
    padding-inline: 1rem;
    background: transparent;
    border: 1px solid transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    will-change: transform;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      max-width 0.35s ease,
      padding-inline 0.35s ease;
  }

  @media (width >= 40rem) {
    .site-nav:not([data-popped="true"]) {
      padding-inline: 1.5rem;
    }
  }

  /* Popped state: detached pill, one step wider than the content column */
  .site-nav[data-popped="true"] {
    max-width: var(--container-5xl);
    padding-inline: 0.75rem;
    background: hsl(var(--background) / 0.7);
    border-color: hsl(var(--border) / 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px hsl(0 0% 0% / 0.08);
  }

  @media (width >= 40rem) {
    .site-nav[data-popped="true"] {
      padding-inline: 2rem;
    }
  }

  .site-nav.nav-pop {
    animation: nav-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .site-nav.nav-settle {
    animation: nav-settle 0.4s ease-out both;
  }

  @keyframes nav-pop {
    0% {
      transform: scale(0.96);
    }
    60% {
      transform: scale(1.015);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes nav-settle {
    0% {
      transform: scale(1.015);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav.nav-pop,
    .site-nav.nav-settle {
      animation: none;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  if (nav) {
    const THRESHOLD = 24;
    let popped = nav.dataset.popped === "true";

    const setPopped = (value: boolean) => {
      if (value === popped) return;
      popped = value;
      nav.dataset.popped = String(value);
      if (value) {
        // Re-trigger the pop animation on every detach
        nav.classList.remove("nav-settle");
        nav.classList.remove("nav-pop");
        void nav.offsetWidth;
        nav.classList.add("nav-pop");
      } else {
        nav.classList.remove("nav-pop");
        // Sits back with its own settling motion
        nav.classList.remove("nav-settle");
        void nav.offsetWidth;
        nav.classList.add("nav-settle");
      }
    };

    // Handle loading mid-page (e.g. refresh while scrolled down)
    setPopped(window.scrollY > THRESHOLD);
    window.addEventListener(
      "scroll",
      () => {
        setPopped(window.scrollY > THRESHOLD);
      },
      { passive: true },
    );
  }
</script>
