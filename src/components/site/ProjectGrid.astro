---
import { projects } from "@/data/projects"
import ProjectCard from "./ProjectCard.astro"

let githubData: Record<string, any> = {}
try {
  githubData = await import("@/data/github.json").then((m) => m.default)
} catch {
  // github.json not yet generated — cards will render without stats
}

const totalProjects = projects.length
---

<div>
  {/* Header */}
  <div class="flex items-center justify-between px-1 mb-6">
    <div>
      <h3 class="text-2xl font-medium tracking-tight text-foreground">Projects</h3>
      <p class="text-sm text-muted-foreground">
        {totalProjects} projects
      </p>
    </div>
    <a
      href="https://github.com/Adjanour?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span class="hidden sm:inline">View all on GitHub</span>
      <svg viewBox="0 0 24 24" class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 3h6v6"></path>
        <path d="M10 14 21 3"></path>
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      </svg>
    </a>
  </div>

  {/* Desktop: Row layout */}
  <div class="hidden md:flex flex-col gap-1">
    {projects.map((project, i) => (
      <ProjectCard project={project} github={githubData[project.id]} index={i} mode="row" />
    ))}
  </div>

  {/* Mobile: Swipeable card stack */}
  <div class="md:hidden">
    <div class="card-stack" id="project-stack">
      {projects.map((project, i) => (
        <div class="card-stack-item" data-index={i}>
          <ProjectCard project={project} github={githubData[project.id]} index={i} mode="card" />
        </div>
      ))}
    </div>

    {/* Pagination dots */}
    <div class="flex justify-center gap-2 mt-4" id="stack-dots">
      {projects.map((_, i) => (
        <button
          class:list={[
            "stack-dot",
            { "stack-dot--active": i === 0 }
          ]}
          data-index={i}
          aria-label={`Go to project ${i + 1}`}
        />
      ))}
    </div>

    {/* Swipe hint */}
    <p class="text-center text-xs text-muted-foreground/50 mt-2" id="swipe-hint">
      swipe to explore
    </p>
  </div>
</div>

<script>
  function initCardStack() {
    const stack = document.getElementById("project-stack")
    if (!stack) return

    const cards = Array.from(stack.querySelectorAll(".card-stack-item")) as HTMLElement[]
    const dots = Array.from(document.querySelectorAll(".stack-dot")) as HTMLButtonElement[]
    const hint = document.getElementById("swipe-hint")
    const total = cards.length
    let current = 0
    let startX = 0
    let currentX = 0
    let isDragging = false

    function updateStack() {
      cards.forEach((card, i) => {
        const offset = i - current
        if (offset < -1 || offset > 1) {
          card.style.display = "none"
          return
        }
        card.style.display = ""
        card.style.zIndex = String(10 - Math.abs(offset))
        card.style.transform = `scale(${1 - Math.abs(offset) * 0.05}) translateY(${Math.abs(offset) * 10}px)`
        card.style.opacity = String(1 - Math.abs(offset) * 0.3)
        card.style.pointerEvents = offset === 0 ? "auto" : "none"
      })

      dots.forEach((dot, i) => {
        dot.classList.toggle("stack-dot--active", i === current)
      })

      if (hint) {
        hint.style.opacity = current === 0 ? "1" : "0"
      }
    }

    function handleSwipe(direction: "left" | "right") {
      const card = cards[current]
      if (!card) return

      const inner = card.querySelector(".project-card") as HTMLElement
      if (!inner) return

      const xOut = direction === "left" ? "-120%" : "120%"
      const rotate = direction === "left" ? "-8deg" : "8deg"
      inner.style.transition = "transform 0.35s ease, opacity 0.35s ease"
      inner.style.transform = `translateX(${xOut}) rotate(${rotate})`
      inner.style.opacity = "0"

      setTimeout(() => {
        inner.style.transition = ""
        inner.style.transform = ""
        inner.style.opacity = ""

        if (direction === "left" && current < total - 1) {
          current++
        } else if (direction === "right" && current > 0) {
          current--
        }
        updateStack()
      }, 350)
    }

    // Touch events
    stack.addEventListener("touchstart", (e) => {
      startX = (e as TouchEvent).touches[0].clientX
      isDragging = true
    }, { passive: true })

    stack.addEventListener("touchmove", (e) => {
      if (!isDragging) return
      currentX = (e as TouchEvent).touches[0].clientX - startX
      const card = cards[current]
      if (!card) return
      const inner = card.querySelector(".project-card") as HTMLElement
      if (!inner) return
      inner.style.transform = `translateX(${currentX * 0.6}px) rotate(${currentX * 0.04}deg)`
      inner.style.transition = "none"
    }, { passive: true })

    stack.addEventListener("touchend", () => {
      if (!isDragging) return
      isDragging = false
      const card = cards[current]
      const inner = card?.querySelector(".project-card") as HTMLElement

      if (Math.abs(currentX) > 60) {
        handleSwipe(currentX < 0 ? "left" : "right")
      } else if (inner) {
        inner.style.transition = "transform 0.2s ease"
        inner.style.transform = ""
        setTimeout(() => { inner.style.transition = "" }, 200)
      }
      currentX = 0
    })

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const target = parseInt(dot.dataset.index || "0", 10)
        if (target === current) return
        current = target
        updateStack()
      })
    })

    // Keyboard
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") handleSwipe("right")
      if (e.key === "ArrowRight") handleSwipe("left")
    })

    updateStack()
  }

  // Run on load and after view transitions
  document.addEventListener("astro:page-load", initCardStack)
  initCardStack()
</script>

<style>
  /* Card stack (mobile) */
  .card-stack {
    position: relative;
    height: 260px;
    margin: 0 auto;
    max-width: 360px;
  }

  .card-stack-item {
    position: absolute;
    inset: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Pagination dots */
  .stack-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    border: none;
    padding: 0;
    background: hsl(var(--foreground) / 0.15);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .stack-dot:hover {
    background: hsl(var(--foreground) / 0.3);
  }

  .stack-dot--active {
    background: hsl(var(--primary));
    transform: scale(1.3);
  }
</style>
